# Production / demo template for the judge worker image.
# Runtime: Redis (cache /0 + Celery broker /1); FILE testdata: MinIO (STORAGE__*).
# Container: --privileged --cgroupns=host --network host (see deploy/worker/run.sh).
#
# URL tips: password with @ → encode as %40

APP__HOST=0.0.0.0
APP__PORT=8000
APP__DEBUG=false
APP__TIMEZONE=Asia/Shanghai
APP__CONFIG_CRYPTO_KEY=change-me-to-a-long-random-secret

REDIS__URL=redis://:CHANGE_ME@127.0.0.1:6379/0
CELERY__BROKER_URL=redis://:CHANGE_ME@127.0.0.1:6379/1
CELERY__BROKER_VISIBILITY_TIMEOUT=3600
# Results default to REDIS__URL:
# CELERY__RESULT_BACKEND=redis://:CHANGE_ME@127.0.0.1:6379/0

CELERY__WORKER_POOL=threads
# Size to host: 2C/2G demo ≈ 2; larger boxes can raise
CELERY__WORKER_CONCURRENCY=2
CELERY__WORKER_QUEUES=judge
CELERY__WORKER_LOG_LEVEL=INFO
CELERY__WORKER_WITHOUT_MINGLE=true
CELERY__WORKER_WITHOUT_GOSSIP=true
# Contest fairness: 1; demo throughput: 8
JUDGE__WORKER_PREFETCH_MULTIPLIER=1

# pool >= concurrency × standard_parallelism
JUDGE__SANDBOX_WORKER_POOL_SIZE=4
JUDGE__SANDBOX_STANDARD_PARALLELISM=2
JUDGE__CACHE_ENABLED=true
JUDGE__CACHE_DIR=storage/judge-cache

# Isolation (image defaults these on; keep explicit in prod .env)
# Rootfs: usr-merge skeleton at /opt/acoj-rootfs; binds /usr /etc /proc
JUDGE__SANDBOX_ENABLE_NAMESPACES=true
JUDGE__SANDBOX_ENABLE_CGROUP=true
JUDGE__SANDBOX_ROOTFS_PATH=/opt/acoj-rootfs
JUDGE__SANDBOX_BIND_SYSTEM_PATHS=true

ID_GENERATOR__WORKER_ID=1

STORAGE__PROVIDER=minio
STORAGE__ENDPOINT=http://127.0.0.1:9000
STORAGE__BUCKET=acoj
STORAGE__ACCESS_KEY=CHANGE_ME
STORAGE__SECRET_KEY=CHANGE_ME

ACOJ_SANDBOX_BINARY=/usr/local/bin/acosandbox
