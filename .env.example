# acoj-worker environment example
# Runtime: Redis (cache /0 + Celery broker /1); FILE testdata: MinIO via STORAGE__*.

APP__HOST=127.0.0.1
APP__PORT=8000
APP__DEBUG=true
APP__PROCESS_ROLE=all
APP__CONFIG_CRYPTO_KEY=
APP__TIMEZONE=Asia/Shanghai
APP__TRUSTED_PROXY_IPS=[]
DOCKER_TRUSTED_PROXY_IPS=["172.16.0.0/12","127.0.0.1"]

CORS__ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5163","http://127.0.0.1:5163","http://localhost:5174","http://127.0.0.1:5174"]

REDIS__URL=redis://127.0.0.1:6379/0
CELERY__BROKER_URL=redis://127.0.0.1:6379/1
CELERY__BROKER_VISIBILITY_TIMEOUT=3600
# Results default to REDIS__URL; set CELERY__RESULT_BACKEND to override
# Password with @ → %40 in URL

# Judge module (JUDGE__*) — sandbox pool / isolation / testcase cache / celery queue
# Prefetch: contest fairness=1; demo throughput≈8. Use JUDGE__WORKER_PREFETCH_MULTIPLIER
# (not arbitrary CELERY__* extras — unknown keys may fail pydantic extra_forbidden).
# JUDGE__TASK_DEFAULT_QUEUE=judge
# CELERY__WORKER_QUEUES=judge
# CELERY__WORKER_WITHOUT_MINGLE=true
# CELERY__WORKER_WITHOUT_GOSSIP=true
# JUDGE__WORKER_PREFETCH_MULTIPLIER=1
# JUDGE__SANDBOX_WORKER_POOL_SIZE=16
# JUDGE__SANDBOX_STANDARD_PARALLELISM=4
# JUDGE__CACHE_ENABLED=true
# JUDGE__CACHE_DIR=storage/judge-cache
# Local/dev: namespaces/cgroup off (unprivileged). Docker image enables them.
# JUDGE__SANDBOX_ENABLE_NAMESPACES=false
# JUDGE__SANDBOX_ENABLE_CGROUP=false
# Prod/docker worker (--privileged --cgroupns=host):
# JUDGE__SANDBOX_ENABLE_NAMESPACES=true
# JUDGE__SANDBOX_ENABLE_CGROUP=true
# JUDGE__SANDBOX_ROOTFS_PATH=/opt/acoj-rootfs
# JUDGE__SANDBOX_BIND_SYSTEM_PATHS=true

# FILE testdata via MinIO:
# STORAGE__PROVIDER=minio
# STORAGE__ENDPOINT=http://127.0.0.1:9000
# STORAGE__BUCKET=acoj-worker-test
# STORAGE__ACCESS_KEY=...
# STORAGE__SECRET_KEY=...
# Or: bash scripts/ops/print_minio_storage_env.sh

# Password with @ → %40 in Redis URLs
# REDIS__URL=redis://:pass@127.0.0.1:6379/0
# CELERY__BROKER_URL=redis://:pass@127.0.0.1:6379/1

# Optional module plugin controls. Values are comma-separated module/package names.
# HEI_MODULE_PACKAGES=your_company.modules
# HEI_DISABLED_MODULES=biz.cg_test_activity,biz.cg_test_catalog
# HEI_ENABLED_MODULES=biz.cg_test_activity
